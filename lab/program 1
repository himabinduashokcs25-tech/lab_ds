#include <stdio.h>
#include <ctype.h>

#define size 100
char stack[size];
int top = -1;

void push(int x) {
    top = top + 1;
    stack[top] = x;
}

char pop() {
    char x;
    x = stack[top];
    top = top - 1;
    return x;
}

int priority(char x) {
    if (x == '^')
        return 3;
    else if (x == '*' || x == '/')
        return 2;
    else if (x == '+' || x == '-')
        return 1;
    return 0;
}

int main() {
    char infix[size], postfix[size];
    int i, j = 0;
    int valid = 1;
    char x;

    printf("Enter expression: ");
    scanf("%s", infix);

    for (i = 0; infix[i] != '\0'; i++) {
        x = infix[i];

        if (isalnum(x)) {
            postfix[j] = x;
            j = j + 1;
        }
        else if (x == '(') {
            push(x);
        }
        else if (x == ')') {
            while (top != -1 && stack[top] != '(') {
                postfix[j] = pop();
                j = j + 1;
            }
            if (top == -1) {
                valid = 0;
                break;
            }
            pop();
        }
        else {
            while (top != -1 && priority(stack[top]) >= priority(x)) {
                postfix[j] = pop();
                j = j + 1;
            }
            push(x);
        }
    }


    while (top != -1) {
        if (stack[top] == '(') {
            valid = 0;
        }
        postfix[j] = pop();
        j = j + 1;
    }

    postfix[j] = '\0';

    if (valid == 1) {
        printf("Postfix expression: %s\n", postfix);
    } else {
        printf("Invalid expression\n");
    }

    return 0;
}

}

int main() {
    int choice, val, pos;

    while (1) {
        printf("\n1. Insert First  2. Insert Pos  3. Insert End\n");
        printf("4. Delete First  5. Delete Spec 6. Delete Last\n");
        printf("7. Display       8. Exit\n");
        printf("Enter Choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                printf("Enter value: "); scanf("%d", &val);
                insertAtFirst(val); break;
            case 2:
                printf("Enter value & position: "); scanf("%d %d", &val, &pos);
                insertAtPosition(val, pos); break;
            case 3:
                printf("Enter value: "); scanf("%d", &val);
                insertAtEnd(val); break;
            case 4:
                deleteFirst(); break;
            case 5:
                printf("Enter value to delete: "); scanf("%d", &val);
                deleteSpecified(val); break;
            case 6:
                deleteLast(); break;
            case 7:
                display(); break;
            case 8:
                exit(0);
            default:
                printf("Invalid choice!\n");
        }
    }
    return 0;
}

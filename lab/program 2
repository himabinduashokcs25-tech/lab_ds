#include <stdio.h>
#define SIZE 5

int queue[SIZE];
int front = -1;
int rear = -1;

void enqueue(int value) {
    if (rear == SIZE - 1) {
        printf("Queue Overflow!\n");
        return;
    }
    if (front == -1) {
        front = 0;
    }
    rear = rear + 1;
    queue[rear] = value;
}

void dequeue() {
    if (front == -1 ) {
        printf("Queue Underflow!\n");
        return;
    }
    printf("Dequeued: %d\n", queue[front]);
    front = front + 1;
    if (front > rear) {
        front = -1;
        rear = -1;
    }
}
void display() {
    if (front == -1 || front > rear) {
        printf("Empty\n");
    } else {
        for (int i = front; i <= rear; i++) printf("%d ", queue[i]);
        printf("\n");
    }
}

int main() {
    int choice, val;
    while (1) {
        printf("1.Ins 2.Del 3.Disp 4.Exit: ");
        if (scanf(" %d", &choice) != 1) {
            while (getchar() != '\n');
            printf("\nInvalid input! Enter a number.\n");
            continue;
        }

        if (choice == 1) {
            printf("Enter val: ");
            scanf(" %d", &val);
            enqueue(val);
        } else if (choice == 2) {
            dequeue();
        } else if (choice == 3) {
            display();
        } else if (choice == 4) {
            break;
        } else {
            printf("\nInvalid choice!\n");
        }
    }
    return 0;
}
